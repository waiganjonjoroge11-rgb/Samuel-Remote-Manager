{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "devices": {
          "$deviceId": {
            "camera": {
              "archive": {
                ".indexOn": [
                  "capturedAt"
                ]
              }
            }
          }
        }
      }
    }
  }
}
