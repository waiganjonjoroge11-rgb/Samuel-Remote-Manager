{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "devices": {
          "$deviceId": {
            "audioArchive": {
              ".indexOn": ["capturedAt"]
            },
            "camera": {
              "archive": {
                ".indexOn": ["capturedAt"]
              }
            }
          }
        }
      }
    }
  }
}
